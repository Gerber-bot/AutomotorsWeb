# ================================================================
# Automotors Web - Variables de Entorno de Ejemplo
# ================================================================

# Flask
FLASK_APP=run.py
FLASK_DEBUG=False
PORT=5000

# Clave secreta para sesiones seguras (generar una cadena aleatoria y única)
# Ejemplo: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar_por_una_clave_secreta_segura_y_aleatoria

# Configuración de base de datos SQL Server
# Opción A: Cadena de conexión completa (toma precedencia si está definida)
# DATABASE_URI=Driver={ODBC Driver 17 for SQL Server};Server=localhost\SQLEXPRESS;Database=Automotors;Trusted_Connection=yes;

# Opción B: Parámetros individuales
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=Automotors
DB_TRUSTED_CONNECTION=yes

# Si se utiliza autenticación SQL Server en lugar de Windows Authentication:
# DB_USER=sa
# DB_PASSWORD=tu_password_aqui

# Opcional para pruebas locales sin SQL Server activo:
# ENABLE_DEV_ADMIN=true
# DEV_ADMIN_USER=admin
# DEV_ADMIN_PASSWORD=tu_password_temporal
